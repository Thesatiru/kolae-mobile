# Endereço da API (sem barra no final). Em dev, use o IP da sua máquina na rede.
EXPO_PUBLIC_API_URL=
# Mock por área (true = dados falsos seguindo o contrato; false = API real).
# AUTH: login, cadastro, esqueci a senha, perfil e senha. VENUES: esportes e quadras.
# CHAT: conversas com as quadras (true até a API do chat subir; docs/proposta-chat.md do João).
EXPO_PUBLIC_MOCK_AUTH=
EXPO_PUBLIC_MOCK_VENUES=
EXPO_PUBLIC_MOCK_CHAT=true
