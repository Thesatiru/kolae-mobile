{
  "expo": {
    "name": "Kolae",
    "slug": "kolae-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kolae",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {}
    },
    "android": {
      "package": "com.kolae.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0084FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0084FF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#121417"
          }
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Kolae usa suas fotos para você anexar imagens nos posts da Comunidade."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Kolae usa sua localização para mostrar as quadras perto de você e a distância até cada uma."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8c448852-a439-4b3e-a5b2-d90d271ac858"
      }
    },
    "owner": "satiru"
  }
}
